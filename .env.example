# Copie ce fichier en `.env` puis colle ta vraie clé NVIDIA.
# La clé s'obtient sur https://build.nvidia.com (bouton "Get API Key").
# Elle commence par "nvapi-" et n'est affichée qu'une seule fois.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optionnel) URL de l'instance SearXNG pour la recherche web (RAG).
# Voir docker-compose.yml. Par défaut : http://localhost:8888
SEARXNG_URL=http://localhost:8888
